# Example configuration file for ToDo List Application
# Copy this file to .env and modify the values as needed

# Maximum number of projects a user can create
MAX_NUMBER_OF_PROJECTS=10

# Maximum number of tasks per project
MAX_NUMBER_OF_TASKS=100

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=todo_pass
DATABASE_URL=postgresql+psycopg2://todo_user:todo_pass@localhost:5432/todo_db
